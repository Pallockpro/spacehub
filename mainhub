-- Function to create a styled button inside a panel
local function addButton(panel, text, callback, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, 10)
    btn.Text = text
    btn.BackgroundColor3 = color or Color3.fromRGB(30, 30, 60)
    btn.BackgroundTransparency = 0.2
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    btn.Parent = panel
    btn.MouseButton1Click:Connect(function()
        pcall(callback)
        -- visual feedback
        local originalColor = btn.BackgroundColor3
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
        task.wait(0.1)
        btn.BackgroundColor3 = originalColor
    end)
    return btn
end

local function addToggleButton(panel, text, initialState, onToggle)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, 10)
    btn.Text = text .. (initialState and " ✓" or "")
    btn.BackgroundColor3 = initialState and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(30, 30, 60)
    btn.BackgroundTransparency = 0.2
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    btn.Parent = panel
    
    local function updateUI(state)
        btn.Text = text .. (state and " ✓" or "")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(30, 30, 60)
    end
    
    btn.MouseButton1Click:Connect(function()
        local newState = not (btn.Text:find("✓"))
        updateUI(newState)
        pcall(onToggle, newState)
    end)
    return btn
end

