                local px = (input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X
                updateBoost(math.clamp(px, 0, 1))
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
                local px = (input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X
                updateBoost(math.clamp(px, 0, 1))
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = false
            end
        end)

        updateBoost(0)

        -- Start persistent boost loop if not already running
        if not boostConnection then
            -- direction tracking (from original community script)
            local dir = 0
            local val = {
                {Enum.KeyCode.W, 1},
                {Enum.KeyCode.S, -1},
            }
            local chk = function(k)
                for i, v in next, val do
                    if v[1] == k.KeyCode then
                        return v[2]
                    end
                end
            end
            UserInputService.InputBegan:Connect(function(k)
                dir = chk(k) or dir
            end)
            UserInputService.InputEnded:Connect(function(k)
                if chk(k) == dir then
                    dir = 0
                end
            end)

            boostConnection = RunService.RenderStepped:Connect(function()
                local vehiclesFolder = workspace:FindFirstChild("Vehicles")
                if not vehiclesFolder then return end
                for _, vehicle in ipairs(vehiclesFolder:GetChildren()) do
                    if vehicle:IsA("Model") and vehicle.Name ~= "Heli" then
                        local engine = vehicle:FindFirstChild("Engine")
                        if engine then
                            local bf = engine:FindFirstChild("NewForce")
                            if not bf then
                                bf = engine:FindFirstChild("BodyForce") or engine:FindFirstChild("VectorForce")
                                if bf then
                                    bf = bf:Clone()
                                    bf.Parent = engine
                                    bf.Name = "NewForce"
                                end
                            end
                            if bf then
                                local cf = vehicle:GetPrimaryPartCFrame()
                                if cf then
                                    local look = cf.LookVector
                                    local fa = 1
                                    local nameLower = vehicle.Name:lower()
                                    if nameLower:find("bike") then fa = 0.3
                                    elseif nameLower:find("bugg") then fa = 0.5 end
                                    if vehicle:FindFirstChild("Seat") then
                                        local seat = vehicle.Seat
                                        local playerName = seat:FindFirstChild("PlayerName")
                                        if playerName and playerName.Value ~= player.Name then
                                            fa = 0
                                        end
                                    end
                                    bf.Force = Vector3.new(
                                        look.X * 300000 * dir * fa * boostMultiplier,
                                        0,
                                        look.Z * 300000 * dir * fa * boostMultiplier
                                    )
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)

    -- ========== TAB SWITCHING ==========
    scriptsBtn.MouseButton1Click:Connect(function()
        scriptsPanel.Visible = true
        apeiroPanel.Visible = false
        erlcPanel.Visible = false
        jbPanel.Visible = false
        scriptsBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        apeiroBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        erlcBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        jbBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
    end)
    apeiroBtn.MouseButton1Click:Connect(function()
        scriptsPanel.Visible = false
        apeiroPanel.Visible = true
        erlcPanel.Visible = false
        jbPanel.Visible = false
        apeiroBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        scriptsBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        erlcBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        jbBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
    end)
    erlcBtn.MouseButton1Click:Connect(function()
        scriptsPanel.Visible = false
        apeiroPanel.Visible = false
        erlcPanel.Visible = true
        jbPanel.Visible = false
        erlcBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        scriptsBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        apeiroBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        jbBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
    end)
    jbBtn.MouseButton1Click:Connect(function()
        scriptsPanel.Visible = false
        apeiroPanel.Visible = false
        erlcPanel.Visible = false
        jbPanel.Visible = true
        jbBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        scriptsBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        apeiroBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        erlcBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
    end)

    scriptsPanel.Visible = true
    apeiroPanel.Visible = false
    erlcPanel.Visible = false
    jbPanel.Visible = false

    print("✨ Space Hub fully loaded – Scripts, Apeirophobia, ERLC, and JB tabs ready.")
end
