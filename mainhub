-- ========== HUB INITIALIZATION ==========
function InitializeHub()
    -- ========== PERSISTENT STATES ==========
    local walkSpeedEnabled = false
    local walkSpeedValue = 50
    local speedPersistConnection = nil
    local infJumpEnabled = false
    local noclipEnabled = false
    local noclipStepped = nil
    local noclipCharConn = nil

    local infJumpToggleBtn = nil
    local noclipToggleBtn = nil

    -- Car speed boost variables (used by JB tab)
    local boostMultiplier = 1.0
    local boostConnection = nil

    -- ========== HELPER FUNCTIONS ==========
    local function applyWalkSpeed(char)
        if walkSpeedEnabled and char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = walkSpeedValue
        end
    end
    local function startSpeedPersistence()
        if speedPersistConnection then return end
        speedPersistConnection = player.CharacterAdded:Connect(function(char)
            char:WaitForChild("Humanoid")
            applyWalkSpeed(char)
        end)
        applyWalkSpeed(player.Character)
    end

    -- Infinite Jump
    local jumpRequestConn = nil
    local function refreshInfiniteJump()
        if jumpRequestConn then jumpRequestConn:Disconnect() end
        if not infJumpEnabled then return end
        jumpRequestConn = UserInputService.JumpRequest:Connect(function()
            if infJumpEnabled then
                local char = player.Character
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)
    end
    local function setInfiniteJump(state)
        infJumpEnabled = state
        refreshInfiniteJump()
        if infJumpToggleBtn then
            local text = infJumpToggleBtn.Text:gsub(" ✓", "")
            infJumpToggleBtn.Text = text .. (infJumpEnabled and " ✓" or "")
        end
    end

    -- Noclip
    local function applyNoclip(char)
        if noclipEnabled and char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
    local function startNoclip()
        if noclipCharConn then return end
        noclipEnabled = true
        if player.Character then applyNoclip(player.Character) end
        noclipCharConn = player.CharacterAdded:Connect(function(char)
            char:WaitForChild("HumanoidRootPart")
            applyNoclip(char)
        end)
        noclipStepped = RunService.Stepped:Connect(function()
            if noclipEnabled and player.Character then
                applyNoclip(player.Character)
            end
        end)
        if noclipToggleBtn then
            local text = noclipToggleBtn.Text:gsub(" ✓", "")
            noclipToggleBtn.Text = text .. " ✓"
        end
    end
    local function stopNoclip()
        noclipEnabled = false
        if noclipCharConn then noclipCharConn:Disconnect() noclipCharConn = nil end
        if noclipStepped then noclipStepped:Disconnect() noclipStepped = nil end
        if player.Character then
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
        if noclipToggleBtn then
            local text = noclipToggleBtn.Text:gsub(" ✓", "")
            noclipToggleBtn.Text = text
        end
    end
    local function toggleNoclip()
        if noclipEnabled then stopNoclip() else startNoclip() end
    end

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.J then
            setInfiniteJump(not infJumpEnabled)
        elseif input.KeyCode == Enum.KeyCode.N then
            toggleNoclip()
        end
    end)

