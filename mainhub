-- ========== GLOBAL DEBUG ERROR HANDLER ==========
local function safeExecute(callback, buttonName)
    local success, err = pcall(callback)
    if not success then
        warn("[SpaceHub] Error in button '" .. tostring(buttonName) .. "': " .. tostring(err))
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Script Error",
            Text = "Check console (F9) for details",
            Duration = 3
        })
    end
end

