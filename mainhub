            speedBar.Size = UDim2.new(0.5, 0, 1, 0)
            speedBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            speedBar.Parent = speedSliderBg
            
            local speedHandle = Instance.new("TextButton")
            speedHandle.Size = UDim2.new(0, 10, 0, 10)
            speedHandle.Position = UDim2.new(0.5, -5, 0, -3)
            speedHandle.Text = ""
            speedHandle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            speedHandle.Parent = speedBar
            
            local speedValueLabel = Instance.new("TextLabel")
            speedValueLabel.Size = UDim2.new(1, 0, 0, 20)
            speedValueLabel.Position = UDim2.new(0, 0, 0, 60)
            speedValueLabel.Text = "Speed: 16"
            speedValueLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
            speedValueLabel.BackgroundTransparency = 1
            speedValueLabel.Parent = speedFrame
            
            local dragging = false
            speedHandle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                end
            end)
            
            speedHandle.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            
            game:GetService("UserInputService").InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local mousePos = input.Position.X
                    local sliderPos = speedSliderBg.AbsolutePosition.X
                    local newPos = (mousePos - sliderPos) / speedSliderBg.AbsoluteSize.X
                    newPos = math.clamp(newPos, 0, 1)
                    speedBar.Size = UDim2.new(newPos, 0, 1, 0)
                    speedHandle.Position = UDim2.new(newPos, -5, 0, -3)
                    speed = math.floor(16 + (newPos * 84))
                    speedValueLabel.Text = "Speed: " .. speed
                    if speedEnabled then
                        hum.WalkSpeed = speed
                    end
                end
            end)
            
            speedFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    speedEnabled = not speedEnabled
                    if speedEnabled then
                        hum.WalkSpeed = speed
                        currentSpeedLabel.Text = "Speed Boost: ON"
                        currentSpeedLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                    else
                        hum.WalkSpeed = 16
                        currentSpeedLabel.Text = "Speed Boost: OFF"
                        currentSpeedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    end
                end
            end)
            
            game.Players.LocalPlayer.CharacterAdded:Connect(function(newChar)
                wait(0.5)
                hum = newChar:WaitForChild("Humanoid")
                if speedEnabled then
                    hum.WalkSpeed = speed
                end
            end)
            
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Speed Boost",
                Text = "Click the GUI to toggle speed boost",
                Duration = 3
            })
        ]])()
    end
})

