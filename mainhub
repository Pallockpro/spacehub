        stroke.Parent = btn
        local tween = TweenService:Create(stroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Transparency = 0.2})
        tween:Play()
        
        local function updateUI(state)
            btn.Text = text .. (state and " ✓" or "")
        end
        
        btn.MouseButton1Click:Connect(function()
            local newState = not (btn.Text:find("✓"))
            updateUI(newState)
            safeExecute(function() onToggle(newState) end, text)
            local originalColor = stroke.Color
            stroke.Color = Color3.fromRGB(0, 255, 255)
            task.wait(0.1)
            stroke.Color = originalColor
        end)
        return btn
    end

