    -- ========== SCRIPTS TAB ==========
    addSectionHeader(scriptsPanel, "✈️ FLY SCRIPTS")
    addButton(scriptsPanel, "🕊️ Simple Fly (X to toggle)", function()
        loadstring([[
            local plr = game.Players.LocalPlayer
            local char = plr.Character or plr.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart")
            local flying = false
            local speed = 50
            local UIS = game:GetService("UserInputService")
            local RS = game:GetService("RunService")
            local bodyVel = Instance.new("BodyVelocity")
            local bodyGyro = Instance.new("BodyGyro")
            local keys = {W=false,A=false,S=false,D=false,Space=false,Control=false}
            UIS.InputBegan:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.X then
                    flying = not flying
                    if flying then
                        bodyVel.MaxForce = Vector3.new(1e5,1e5,1e5)
                        bodyGyro.MaxTorque = Vector3.new(1e5,1e5,1e5)
                        bodyVel.Parent = root
                        bodyGyro.Parent = root
                        char.Humanoid.PlatformStand = true
                    else
                        bodyVel:Destroy()
                        bodyGyro:Destroy()
                        char.Humanoid.PlatformStand = false
                    end
                end
                if input.KeyCode == Enum.KeyCode.W then keys.W = true end
                if input.KeyCode == Enum.KeyCode.A then keys.A = true end
                if input.KeyCode == Enum.KeyCode.S then keys.S = true end
                if input.KeyCode == Enum.KeyCode.D then keys.D = true end
                if input.KeyCode == Enum.KeyCode.Space then keys.Space = true end
                if input.KeyCode == Enum.KeyCode.LeftControl then keys.Control = true end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.W then keys.W = false end
                if input.KeyCode == Enum.KeyCode.A then keys.A = false end
                if input.KeyCode == Enum.KeyCode.S then keys.S = false end
                if input.KeyCode == Enum.KeyCode.D then keys.D = false end
                if input.KeyCode == Enum.KeyCode.Space then keys.Space = false end
                if input.KeyCode == Enum.KeyCode.LeftControl then keys.Control = false end
            end)
            RS.RenderStepped:Connect(function()
                if flying then
                    local move = Vector3.new(0,0,0)
                    if keys.W then move = move + Vector3.new(0,0,-1) end
                    if keys.S then move = move + Vector3.new(0,0,1) end
                    if keys.A then move = move + Vector3.new(-1,0,0) end
                    if keys.D then move = move + Vector3.new(1,0,0) end
                    if keys.Space then move = move + Vector3.new(0,1,0) end
                    if keys.Control then move = move + Vector3.new(0,-1,0) end
                    local cam = workspace.CurrentCamera
                    move = (cam.CFrame.RightVector * move.X + cam.CFrame.UpVector * move.Y + cam.CFrame.LookVector * move.Z) * speed
                    bodyVel.Velocity = move
                    bodyGyro.CFrame = cam.CFrame
                end
            end)
            game:GetService("StarterGui"):SetCore("SendNotification", {Title="Fly", Text="Press X to toggle"})
        ]])()
    end)

