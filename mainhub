            local rs = game:GetService("RunService")
            local cam = workspace.CurrentCamera
            local lp = players.LocalPlayer
            local enabled = false
            local fov = 350
            local function getClosest()
                local closest, shortest = nil, fov
                local mpos = uis:GetMouseLocation()
                for _, p in ipairs(players:GetPlayers()) do
                    if p ~= lp and p.Character then
                        local head = p.Character:FindFirstChild("Head")
                        local hum = p.Character:FindFirstChild("Humanoid")
                        if head and hum and hum.Health > 0 then
                            local sp, vis = cam:WorldToViewportPoint(head.Position)
                            if vis then
                                local d = (Vector2.new(sp.X, sp.Y) - mpos).Magnitude
                                if d < shortest then shortest = d; closest = head end
                            end
                        end
                    end
                end
                return closest
            end
            rs.RenderStepped:Connect(function()
                if enabled and uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                    local t = getClosest()
                    if t then
                        cam.CFrame = CFrame.new(cam.CFrame.Position, t.Position)
                    end
                end
            end)
            uis.InputBegan:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.B then
                    enabled = not enabled
                    game:GetService("StarterGui"):SetCore("SendNotification", {
