-- Auto Clicker (Spam Click)
ApeiroTab:CreateButton({
    Name = "🖱️ Auto Clicker (Spam Click)",
    Callback = function()
        loadstring([[
            local UserInputService = game:GetService("UserInputService")
            local clicking = false
            local clickConnection = nil
            
            local function startClicking()
                if clickConnection then return end
                clickConnection = game:GetService("RunService").RenderStepped:Connect(function()
                    if clicking then
                        local mouse = game.Players.LocalPlayer:GetMouse()
                        mouse1press()
                        wait(0.05)
                        mouse1release()
                    end
                end)
            end
            
            local function stopClicking()
                if clickConnection then
                    clickConnection:Disconnect()
                    clickConnection = nil
                end
            end
            
            UserInputService.InputBegan:Connect(function(input)
                if input.KeyCode == Enum.KeyCode.C then
                    clicking = not clicking
                    if clicking then
                        startClicking()
                        game:GetService("StarterGui"):SetCore("SendNotification", {Title="Auto Clicker", Text="ON (C to toggle)", Duration=1})
                    else
                        stopClicking()
                        game:GetService("StarterGui"):SetCore("SendNotification", {Title="Auto Clicker", Text="OFF (C to toggle)", Duration=1})
                    end
                end
            end)
            
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Auto Clicker",
                Text = "Press C to toggle auto-clicking",
                Duration = 3
            })
        ]])()
    end
})

