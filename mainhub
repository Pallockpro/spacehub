            end
        end)
        game:GetService("StarterGui"):SetCore("SendNotification", {Title="Auto Clicker", Text="Press C to toggle"})
    ]])()
end)

addApeiroButton("⚡ Speed Boost (GUI Slider)", function()
    loadstring([[
        local player = game.Players.LocalPlayer
