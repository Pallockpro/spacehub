local function applySpaceTheme()
    -- Wait for the Rayfield GUI to be created
    local gui = game:GetService("CoreGui"):FindFirstChild("Rayfield")
    if gui then
        -- Set overall background to transparent so we can add our own
        local mainFrame = gui:FindFirstChild("MainFrame")
        if mainFrame then
            mainFrame.BackgroundColor3 = Color3.fromRGB(8, 8, 20)
            mainFrame.BackgroundTransparency = 0.15
            mainFrame.BorderSizePixel = 0
        end
        
        -- Add a starfield background (static image, no animation)
        local starfield = Instance.new("ImageLabel")
        starfield.Name = "StarfieldBG"
        starfield.Image = "rbxassetid://135740367" -- space/starfield decal ID (light stars)
        starfield.ImageColor3 = Color3.fromRGB(80, 100, 200)
        starfield.ImageTransparency = 0.85
        starfield.ScaleType = Enum.ScaleType.Crop
        starfield.BackgroundTransparency = 1
        starfield.Size = UDim2.new(1, 0, 1, 0)
        starfield.Position = UDim2.new(0, 0, 0, 0)
        starfield.ZIndex = 0
        starfield.Parent = gui
        
        -- Move starfield behind the main interface
        local mainFrame1 = gui:FindFirstChild("MainFrame")
        if mainFrame1 then
            mainFrame1.ZIndex = 2
        end
        for _, child in pairs(gui:GetChildren()) do
            if child:IsA("Frame") and child ~= starfield then
                child.ZIndex = 2
            end
        end
        
        -- Change accent colors (buttons, sliders, etc.)
        local styleSheet = gui:FindFirstChild("StyleSheet")
        if styleSheet then
            -- We can't directly edit StyleSheet, but we can override colors via theme
            -- Rayfield uses Color3 values from its theme; better to set custom theme on creation
        end
    end
end

