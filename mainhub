-- ========== STYLED BUTTON CREATION (with animated border) ==========
local function addButton(panel, text, callback, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 38)
    btn.Text = text
    btn.BackgroundColor3 = color or Color3.fromRGB(30, 30, 55)
    btn.BackgroundTransparency = 0.2
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    btn.Parent = panel
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    -- Animated glowing border (pulse effect)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(0, 200, 255)
    stroke.Transparency = 0.8
    stroke.Parent = btn
    
    -- Create pulsing tween
    local tweenInfo = TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local tween = TweenService:Create(stroke, tweenInfo, {Transparency = 0.2})
    tween:Play()
    
    btn.MouseButton1Click:Connect(function()
        safeExecute(callback, text)
        local originalColor = btn.BackgroundColor3
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
        task.wait(0.1)
        btn.BackgroundColor3 = originalColor
    end)
    return btn
end

local function addToggleButton(panel, text, initialState, onToggle)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 38)
    btn.Text = text .. (initialState and " ✓" or "")
    btn.BackgroundColor3 = initialState and Color3.fromRGB(0, 130, 100) or Color3.fromRGB(30, 30, 55)
    btn.BackgroundTransparency = 0.2
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    btn.Parent = panel
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(0, 200, 255)
    stroke.Transparency = 0.8
    stroke.Parent = btn
    local tween = TweenService:Create(stroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Transparency = 0.2})
    tween:Play()
    
    local function updateUI(state)
        btn.Text = text .. (state and " ✓" or "")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 130, 100) or Color3.fromRGB(30, 30, 55)
    end
    
    btn.MouseButton1Click:Connect(function()
        local newState = not (btn.Text:find("✓"))
        updateUI(newState)
        safeExecute(function() onToggle(newState) end, text)
    end)
    return btn
end

