-- Persistent Noclip
local noclipEnabled = false
local noclipConnection = nil
local noclipStepped = nil

local function applyNoclip(char)
    if noclipEnabled and char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

local function startNoclipPersistence()
    if noclipConnection then return end
    noclipEnabled = true
    local player = game.Players.LocalPlayer
    
    if player.Character then applyNoclip(player.Character) end
    
    noclipConnection = player.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart")
        applyNoclip(char)
    end)
    
    noclipStepped = game:GetService("RunService").Stepped:Connect(function()
        if noclipEnabled and player.Character then
            applyNoclip(player.Character)
        end
    end)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {Title="Noclip", Text="Enabled (Press N to toggle)", Duration=2})
end

game:GetService("UserInputService").InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.N then
        noclipEnabled = not noclipEnabled
        local player = game.Players.LocalPlayer
        if noclipEnabled then
            if player.Character then applyNoclip(player.Character) end
        else
            if player.Character then
                for _, part in pairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
        local status = noclipEnabled and "ON" or "OFF"
        game:GetService("StarterGui"):SetCore("SendNotification", {Title="Noclip", Text=status, Duration=1})
    end
end)

MainTab:CreateButton({
